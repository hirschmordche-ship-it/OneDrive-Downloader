{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.ts" },
    { "src": "/(?!api/)(.+\\.(js|css|json|png|jpg|gif|svg|ico|woff|woff2))", "status": 200 },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
